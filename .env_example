# ==========================================
# GIOFCHAR BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------
NODE_ENV=development
PORT=8081
HOST_NAME=localhost
SESSION_SECRET=dev_session_secret_key_change_in_production
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------
# 2. Database (MySQL) Configuration
# ------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=GIOFCHAR
DB_PORT=3306

# Docker MySQL Container Environment
MYSQL_DATABASE=GIOFCHAR
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=giofchar_user
MYSQL_PASSWORD=giofchar_password

# ------------------------------------------
# 3. JWT Security & Authentication
# ------------------------------------------
ACCESS_TOKEN_SECRET=dev_access_token_secret_key_32chars_min
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=dev_refresh_token_secret_key_32chars_min
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------
# 4. Cloudinary (External Image Storage)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------
# 5. Google Gemini AI (Consulting & AI Search)
# ------------------------------------------
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# ------------------------------------------
# 6. VNPay Payment Gateway
# ------------------------------------------
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNP_IPN_URL=http://localhost:8081/api/v1/payments/vnpay_ipn

# ------------------------------------------
# 7. Email Outbox (Resend)
# ------------------------------------------
# Configure both values to enable the email worker.
RESEND_API_KEY=
EMAIL_FROM=
